<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="100dp">

    <TextView
        android:id="@+id/GroupName"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textSize="16dp"
        android:layout_marginTop="10dp"
        android:layout_marginStart="16dp"
        android:fontFamily="@font/cygre_bold"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        android:text="21-КБ-ПР1"/>

    <TextView
        android:id="@+id/Course"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:layout_marginStart="6dp"
        android:textSize="16dp"
        android:text="3 Курс"
        app:layout_constraintBottom_toBottomOf="@+id/GroupName"
        app:layout_constraintStart_toEndOf="@+id/GroupName"
        app:layout_constraintTop_toTopOf="@+id/GroupName"
        android:fontFamily="@font/montserrat_regular"
        android:textColor="#454545"/>

    <TextView
        android:id="@+id/InstName"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="16dp"
        android:fontFamily="@font/cygre_bold"
        android:text="Институт компьютерных систем и информационной безопасности"
        android:textColor="#515151"
        android:textSize="16dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/GroupName" />

    <TextView
        android:id="@+id/EFName"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="16dp"
        android:fontFamily="@font/cygre_regular"
        android:text="Очная форма обучения"
        app:layout_constraintBottom_toBottomOf="@+id/GroupName"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/GroupName" />


</androidx.constraintlayout.widget.ConstraintLayout>