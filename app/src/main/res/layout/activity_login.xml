<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/rooty"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".View.LogInActivity">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/constraintLayout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <androidx.viewpager2.widget.ViewPager2
            android:id="@+id/ViewPagerOnBoarding"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            tools:layout_editor_absoluteX="0dp"
            tools:layout_editor_absoluteY="-53dp" />

    </androidx.constraintlayout.widget.ConstraintLayout>


    <FrameLayout
        android:id="@+id/btmSht"
        android:layout_width="match_parent"
        android:layout_height="1200dp"
        app:layout_behavior="com.google.android.material.bottomsheet.BottomSheetBehavior">

        <androidx.cardview.widget.CardView
            android:id="@+id/bottomsheetnegr"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:cardCornerRadius="40dp">

            <ImageView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@color/blue"/>

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <LinearLayout
                android:alpha="0"
                android:id="@+id/LayoutOnBoardingIndicator"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="200dp"
                android:layout_marginEnd="200dp"
                android:orientation="horizontal"
                android:padding="15dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <LinearLayout
                android:id="@+id/LogoLayer"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:orientation="vertical"
                android:gravity="center"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/LayoutOnBoardingIndicator">



                    <ImageView
                        android:id="@+id/LogoImg"
                        android:layout_width="200dp"
                        android:layout_height="200dp"
                        android:adjustViewBounds="true"
                        android:alpha="0"
                        android:src="@drawable/logo1" />

                    <TextView
                        android:id="@+id/LogoText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:alpha="0"
                        android:gravity="center"
                        android:fontFamily="@font/montserrat_semibold"
                        android:text="Кубанский государственный\nтехнологический университет"
                        android:textColor="@color/white"
                        android:textSize="16dp"
                        android:textStyle="bold"/>

            </LinearLayout>

            <Button
                android:id="@+id/BtnOnBoardingAction"
                android:layout_width="315dp"
                android:layout_height="70dp"
                android:layout_marginTop="35dp"
                android:backgroundTint="@color/white"
                android:foregroundTint="@color/white"
                android:text="Перейти в приложение"
                android:textAllCaps="false"
                android:fontFamily="@font/cygre_bold"
                android:textColor="@color/black"
                android:textSize="20dp"
                android:letterSpacing="0.01"
                app:cornerRadius="5dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/LayoutOnBoardingIndicator" />

        </androidx.constraintlayout.widget.ConstraintLayout>

        </androidx.cardview.widget.CardView>
    </FrameLayout>

    <FrameLayout
        android:id="@+id/btmSht2"
        android:layout_width="match_parent"
        android:layout_height="520dp"
        android:layout_marginTop="10dp"
        app:layout_behavior="com.google.android.material.bottomsheet.BottomSheetBehavior"
        android:background="@drawable/rounded2"
        app:behavior_peekHeight="300dp">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginHorizontal="60dp"
            android:layout_marginTop="40dp">


            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/stage1"
                android:layout_width="match_parent"
                android:layout_height="300dp"
                android:alpha="1"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent">

                <TextView
                    android:id="@+id/textView411"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:letterSpacing="0"
                    android:lineHeight="27dp"
                    android:text="Выберите вашу\nакадемическую группу"
                    android:textColor="@color/black"
                    android:textSize="24dp"
                    android:textStyle="bold"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <TextView
                    android:id="@+id/textView511"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:fontFamily="@font/montserrat_regular"
                    android:text="Группа"
                    android:textColor="@android:color/background_dark"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/textView411"/>

                <Button
                    android:id="@+id/ChooseGroupBtn"
                    android:layout_width="100dp"
                    android:layout_height="60dp"
                    android:backgroundTint="@color/blue"
                    android:fontFamily="@font/montserrat_regular"
                    android:letterSpacing="0.01"
                    android:text="Выбрать"
                    android:textAllCaps="false"
                    android:textColor="@color/white"
                    android:textSize="14dp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/textView511" />

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/GroupTB"
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.Dense"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:textColorHint="@color/HintStart"
                    app:boxStrokeColor="@color/blue"
                    app:boxStrokeWidthFocused="1dp"
                    app:endIconMode="clear_text"
                    android:layout_marginEnd="10dp"
                    android:enabled="false"
                    app:errorEnabled="true"
                    app:helperTextTextColor="@color/blue"
                    app:layout_constraintEnd_toStartOf="@id/ChooseGroupBtn"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/textView511">

                    <EditText
                        android:id="@+id/GroupTE"
                        android:layout_width="match_parent"
                        android:layout_height="50dp"
                        android:enabled="false"
                        android:hint="Нажмите, чтобы выбрать группу"
                        android:inputType="none"
                        android:textColor="@color/black"
                        android:textColorHint="@color/black" />


                </com.google.android.material.textfield.TextInputLayout>

                <Button
                    android:id="@+id/GroupBtn"
                    android:layout_width="match_parent"
                    android:layout_height="60dp"
                    android:backgroundTint="@color/blue"
                    android:text="Продолжить"
                    android:letterSpacing="0.01"
                    android:textAllCaps="false"
                    android:fontFamily="@font/montserrat_regular"
                    android:textSize="20dp"
                    android:textColor="@color/white"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/GroupTB" />

            </androidx.constraintlayout.widget.ConstraintLayout>


            <androidx.constraintlayout.widget.ConstraintLayout
                android:alpha="0"
                android:id="@+id/stage2"
                android:layout_width="match_parent"
                android:layout_height="400dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent">

                <TextView
                    android:id="@+id/GroupTV"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:letterSpacing="0"
                    android:enabled="false"
                    android:lineHeight="27dp"
                    android:text="Заполните профиль"
                    android:textColor="@color/black"
                    android:textSize="24dp"
                    android:textStyle="bold"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <TextView
                    android:id="@+id/GroupLable"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:text="Фамилия"
                    android:fontFamily="@font/montserrat_regular"
                    android:enabled="false"
                    android:textColor="@android:color/background_dark"
                    app:layout_constraintTop_toBottomOf="@+id/GroupTV"
                    app:layout_constraintStart_toStartOf="parent"/>

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/SurNameTB"
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.Dense"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColorHint="@color/HintStart"
                    app:boxStrokeColor="@color/blue"
                    app:boxStrokeWidthFocused="1dp"
                    app:endIconMode="clear_text"
                    app:errorEnabled="true"
                    android:enabled="false"
                    app:helperTextTextColor="@color/blue"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/GroupLable">

                    <EditText
                        android:enabled="false"
                        android:id="@+id/SurNameTE"
                        android:layout_width="match_parent"
                        android:layout_height="50dp"
                        android:inputType="textPersonName"
                        android:textColor="@color/black"
                        android:textColorHint="@color/black" />

                </com.google.android.material.textfield.TextInputLayout>

                <TextView
                    android:id="@+id/NameText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Имя"
                    android:fontFamily="@font/montserrat_regular"
                    android:enabled="false"
                    android:textColor="@android:color/background_dark"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/SurNameTB" />

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/NameTB"
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.Dense"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColorHint="@color/HintStart"
                    app:boxStrokeColor="@color/blue"
                    app:boxStrokeWidthFocused="1dp"
                    app:errorEnabled="false"
                    android:enabled="false"
                    app:helperTextTextColor="@color/blue"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/NameText">

                    <EditText
                        android:id="@+id/NameTE"
                        android:layout_width="match_parent"
                        android:layout_height="50dp"
                        android:enabled="false"
                        android:inputType="textPersonName"
                        android:textColor="@android:color/background_dark"
                        android:textColorHint="@color/black" />


                </com.google.android.material.textfield.TextInputLayout>


                <Button
                    android:id="@+id/LogInBtn"
                    android:enabled="false"
                    android:layout_width="match_parent"
                    android:layout_height="60dp"
                    android:fontFamily="@font/montserrat_regular"
                    android:backgroundTint="@color/blue"
                    android:layout_marginTop="20dp"
                    android:text="Войти"
                    android:letterSpacing="0.01"
                    android:textAllCaps="false"
                    android:textSize="20dp"
                    android:textColor="@color/white"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/NameTB" />


                <TextView
                    android:id="@+id/terms_and_conditions_text_view"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:autoLink="web"
                    android:fontFamily="@font/montserrat_regular"
                    android:text="Нажимая кнопку «Войти», вы принимаете условия использования и даете согласие ФГБОУ ВО «КубГТУ» на обработку ваших персональных данных в соотвествии с его политикой"
                    android:textColor="@color/cyan"
                    android:textSize="11dp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/LogInBtn" />

            </androidx.constraintlayout.widget.ConstraintLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                android:layout_marginBottom="20dp"
                android:gravity="center">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/blue_heart"/>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="10dp"
                    android:fontFamily="@font/montserrat_regular"
                    android:layout_marginStart="10dp"
                    android:gravity="center"
                    android:text="Разработано Управлением информатизации КубГТУ и студентами кафедры информационных систем и программирования КубГТУ"/>

            </LinearLayout>

        </androidx.constraintlayout.widget.ConstraintLayout>

    </FrameLayout>

</androidx.coordinatorlayout.widget.CoordinatorLayout>